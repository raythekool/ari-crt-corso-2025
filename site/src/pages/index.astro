---
import "../styles/landing.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (Astro.site?.origin ?? "https://raythekool.github.io") + base;
const lesson = (n: number) =>
  `${base}/lezioni/lezione_${String(n).padStart(2, "0")}/`;

const buildNumber = process.env.SITE_BUILD_NUMBER ?? process.env.GITHUB_RUN_NUMBER ?? "dev";
const buildDate = new Intl.DateTimeFormat("it-IT", {
  dateStyle: "short",
  timeStyle: "short",
  timeZone: "Europe/Rome",
}).format(new Date());

const title = "Corso ARI Toscana CRT 2026 — Guide di studio per radioamatori";
const description =
  "Appunti estratti dalle 22 lezioni del corso per radioamatori della Toscana (ARI Toscana CRT, edizioni 2025 e 2026): elettrotecnica, RF, antenne e normativa, con strumenti di ripasso e le lezioni utili per l’esame ridotto.";

const problems = [
  {
    icon: "📡",
    title: "Un programma vastissimo",
    text: "Elettrotecnica, componenti, ricezione, antenne, propagazione e normativa: molti argomenti, tutti da esame.",
  },
  {
    icon: "🔗",
    title: "Concetti a catena",
    text: "Per capire un ricevitore servono semiconduttori e corrente alternata. Saltare un passaggio costa caro più avanti.",
  },
  {
    icon: "🎥",
    title: "Lezioni lunghe",
    text: "Ogni serata dura oltre un’ora: ritrovare una spiegazione o una formula in una registrazione è lento.",
  },
  {
    icon: "📜",
    title: "Normativa da ricordare",
    text: "D.Lgs. 259/2003, CEPT, ITU, classi di autorizzazione, nominativi: sigle e articoli che si confondono facilmente.",
  },
];

const features = [
  {
    icon: "📖",
    title: "Guide esaustive",
    text: "Ogni lezione è riorganizzata come appunto di studio consultabile: utile per ripassare senza cercare ogni volta nel video.",
  },
  {
    icon: "🗺️",
    title: "Mappa concettuale",
    text: "Relazioni tra i concetti in brevi frasi: causa, effetto, caso particolare.",
  },
  {
    icon: "🔑",
    title: "Punti chiave",
    text: "Le regole e i principi essenziali delle serate, in elenco, pronti per il ripasso.",
  },
  {
    icon: "❓",
    title: "Domande di autoverifica",
    text: "Domande aperte che richiedono ragionamento, non solo memoria. Le risposte le trovi tu.",
  },
  {
    icon: "📚",
    title: "Glossario per lezione",
    text: "I termini tecnici sono definiti alla prima occorrenza e raccolti in ordine alfabetico.",
  },
  {
    icon: "🔎",
    title: "Ricerca e tema scuro",
    text: "Ricerca istantanea su tutte le guide, navigazione laterale e tema chiaro o scuro.",
  },
];

const tracks = [
  {
    icon: "🧭",
    name: "Fondamenti",
    range: "Lezioni 1–9",
    start: 1,
    text: "Elettrotecnica, circuiti, corrente alternata, componenti, semiconduttori, modi di emissione, procedure e bande.",
    featured: false,
  },
  {
    icon: "🔧",
    name: "Elettronica",
    range: "Lezioni 10–15",
    start: 10,
    text: "Diodi, alimentatori, transistor, amplificatori, oscillatori, trasmettitori, ricevitori e strumenti di misura.",
    featured: true,
  },
  {
    icon: "📶",
    name: "Radio e normativa",
    range: "Lezioni 16–22",
    start: 16,
    text: "Linee di trasmissione, propagazione, antenne e normativa nazionale e internazionale.",
    featured: false,
  },
];

const faqs = [
  {
    q: "Le guide sostituiscono il corso?",
    a: "No. Sono appunti estratti dalle lezioni del corso per radioamatori della Toscana (ARI Toscana CRT, edizioni 2025 e 2026): servono a ripassare e ritrovare un passaggio, non a sostituire il corso.",
  },
  {
    q: "Quali lezioni servono per l’esame ridotto?",
    a: "Servono la Lezione 08, la Lezione 09 e la Lezione 22: coprono le Parti B e C del programma. Le altre 19 lezioni sono la Parte A e servono solo per l’esame completo. Alcuni punti B e C non sono negli appunti.",
    link: "Vedi la sezione sugli esami →",
    href: "#esami",
  },
  {
    q: "Da dove arrivano i contenuti?",
    a: "Dalle lezioni in diretta del corso ARI Toscana CRT delle edizioni 2025 e 2026, dalle relative trascrizioni e dalle slide di entrambe le edizioni. Gli errori evidenti di trascrizione vengono corretti, senza aggiungere informazioni assenti nella lezione.",
  },
  {
    q: "Ci sono le risposte alle domande di autoverifica?",
    a: "No, di proposito: sono domande aperte pensate per verificare di aver capito, non per essere memorizzate.",
  },
  {
    q: "Posso consultare il sito offline?",
    a: "Il sito va consultato online: la modalità lettura adatta la pagina all’iPad ma non scarica le lezioni per l’uso offline.",
  },
];

const examLessons = [
  {
    n: 8,
    title: "Procedure e Alfabeto Telefonetico",
    points: "B.1, B.2, B.3, B.5",
    sections: [
      ["§1 Alfabeto telefonetico", "B.1"],
      ["§2 Indicativo di chiamata", "B.5"],
      ["§3 Abbreviazioni telegrafiche", "B.3"],
      ["§4 Codice Q", "B.2"],
      ["§5 Sistema RS(T)", "B.3"],
    ],
    note: "Il §6 (Maidenhead Locator) non compare nel programma ufficiale.",
  },
  {
    n: 9,
    title: "Bande Radioamatoriali, Normativa e Enti",
    points: "B.6, C.1, C.3",
    sections: [
      ["§3 Bande radioamatoriali e tipologie di utilizzo", "C.1"],
      ["§4 Larghezza di banda e band plan", "B.6"],
      ["§5 Enti: ITU, IARU, ARI", "C.1 · B.6"],
      ["§6 Normativa italiana: MIMIT, patente e autorizzazione generale", "C.3"],
    ],
    note: "I §1–2 (lunghezza d’onda, spettro) sono Parte A.",
  },
  {
    n: 22,
    title: "Normativa Nazionale e Internazionale",
    points: "C.1, C.2, C.3",
    sections: [
      ["§2 Parole chiave", "C.1 · C.2"],
      ["§3 Gerarchia normativa", "C.3"],
      ["§4 D.Lgs. 259/2003", "C.3"],
      ["§5 ITU art. 25", "C.1"],
      ["§6 CEPT TR 61-01 e TR 61-02", "C.2"],
      ["§7–16 Articoli 134-144 e allegato 26", "C.3"],
      ["§17 Domande e risposte", ""],
    ],
    note: "Il §1 (correzione del quiz sulle antenne) è Parte A.",
  },
];

const sources = [
  {
    name: "Decreto MISE 1 marzo 2021",
    detail: "Gazzetta Ufficiale n. 70 del 22-03-2021: art. 3 (esami), art. 5 (esonero), Sub allegato D (programma)",
    href: "https://www.gazzettaufficiale.it/eli/id/2021/03/22/21A01607/sg",
  },
  {
    name: "Decreto direttoriale MIMIT 6 marzo 2024",
    detail: "prot. 49052: modalità della prova scritta",
    href: "https://ispettorati.mise.gov.it/images/documenti/decreto_esami_radioamatori_2024.pdf",
  },
  {
    name: "Determina Ispettorato Toscana, sessione 2026",
    detail: "date e modalità di domanda per il 2026",
    href: "https://ispettorati.mise.gov.it/images/TOSCANA/radioamatori/Esami_Radioamatori_2026.pdf",
  },
  {
    name: "Circolare MIMIT sull’esonero parziale",
    detail: "chi ha l’esonero sostiene comunque le Parti B e C",
    href: "https://www.mimit.gov.it/images/stories/documenti/IITT_esonero_parziale_esami_radioamatori.pdf",
  },
];

---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1220" />
    <link rel="canonical" href={`${site}/`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta
      property="og:image:alt"
      content="ARI Toscana CRT — appunti di studio estratti dalle lezioni delle edizioni 2025 e 2026"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Vai al contenuto</a>

    <header class="site-header">
      <div class="container bar">
        <a
          class="brand"
          href={`${base}/`}
          aria-label="Corso ARI Toscana CRT 2026 — home"
        >
          <img src={`${base}/favicon.svg`} alt="" width="28" height="28" />
          <span>Corso ARI CRT 2026</span>
        </a>
        <nav aria-label="Principale">
          <a href="#problema">Il problema</a>
          <a href="#funzionalita">Funzionalità</a>
          <a href="#percorsi">Percorsi</a>
          <a href="#esami">Gli esami</a>
          <a href="#faq">FAQ</a>
        </nav>
        <a class="btn btn-sm" href={lesson(1)}>Inizia a studiare</a>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <p class="eyebrow eyebrow-dark">ARI Toscana · Corso 2026</p>
            <h1>
              Gli appunti del corso per aspiranti <span class="grad">radioamatori</span>, in
              guide di studio
            </h1>
            <p class="lead">
              Appunti estratti dalle 22 lezioni del corso per radioamatori
              della Toscana (edizioni 2025 e 2026): teoria, formule, mappe concettuali, glossario e
              domande di autoverifica per ripassare con ordine verso l’esame.
            </p>
            <div class="actions">
              <a class="btn" href={lesson(1)}>Inizia dalla Lezione 1</a>
              <a class="btn btn-ghost" href={`${base}/lezioni/`}
                >Vedi tutte le lezioni</a
              >
            </div>
            <ul class="badges" aria-label="Caratteristiche">
              <li>22 lezioni</li>
              <li>In italiano</li>
              <li>Edizioni 2025 e 2026</li>
            </ul>
          </div>

          <div
            class="terminal"
            role="img"
            aria-label="Simulazione di terminale: il corso carica 22 lezioni con guide di studio e strumenti di autoverifica"
          >
            <div class="term-bar" aria-hidden="true">
              <span class="dot r"></span><span class="dot y"></span><span
                class="dot g"></span>
              <span class="term-title">ari-crt — studio</span>
            </div>
            <div class="term-body" aria-hidden="true">
              <p style="--i:0">
                <span class="prompt">$</span> ari-crt corso --anno 2026
              </p>
              <p style="--i:1" class="ok">✔ 22 lezioni caricate</p>
              <p style="--i:2" class="ok">✔ guide · ripasso · autoverifica</p>
              <p style="--i:3">
                <span class="prompt">$</span> ari-crt studia antenne
              </p>
              <p style="--i:4" class="muted">
                → Lezione 18 · Antenne, parte prima
              </p>
              <p style="--i:5" class="muted">
                → Lezione 21 · Direttività e guadagno
              </p>
              <p style="--i:6">
                <span class="prompt">$</span> ari-crt esame<span class="caret"
                ></span>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Problema -->
      <section id="problema" class="section">
        <div class="container">
          <header class="section-head reveal">
            <p class="eyebrow">Il problema</p>
            <h2>Preparare l’esame non è semplice</h2>
            <p>
              Il programma è ampio e ogni argomento poggia su quello precedente.
            </p>
          </header>
          <div class="grid grid-4">
            {
              problems.map((p) => (
                <article class="card reveal">
                  <span class="icon" aria-hidden="true">
                    {p.icon}
                  </span>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Funzionalità -->
      <section id="funzionalita" class="section alt">
        <div class="container">
          <header class="section-head reveal">
            <p class="eyebrow">Funzionalità</p>
            <h2>Tutto quello che serve per studiare</h2>
            <p>
              Le guide seguono una struttura comune. La maggior parte include
              mappa concettuale, punti chiave, domande e glossario.
            </p>
          </header>
          <div class="grid grid-3">
            {
              features.map((f) => (
                <article class="card reveal">
                  <span class="icon" aria-hidden="true">
                    {f.icon}
                  </span>
                  <h3>{f.title}</h3>
                  <p>{f.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Come funziona -->
      <section id="come-funziona" class="section">
        <div class="container">
          <header class="section-head reveal">
            <p class="eyebrow">Come funziona</p>
            <h2>Dalla lezione in diretta all’esame</h2>
            <p>
              Un percorso in cinque passaggi, dalla registrazione al ripasso
              finale.
            </p>
          </header>
          <figure class="flow reveal">
            <svg
              class="flow-h"
              viewBox="0 0 960 220"
              role="img"
              aria-labelledby="flow-h-t flow-h-d"
              xmlns="http://www.w3.org/2000/svg"
            >
              <title id="flow-h-t">Percorso di studio</title>
              <desc id="flow-h-d"
                >Lezione in diretta, trascrizione, guida di studio, autoverifica
                ed esame.</desc
              >
              <defs>
                <marker
                  id="ah"
                  viewBox="0 0 10 10"
                  refX="8"
                  refY="5"
                  markerWidth="7"
                  markerHeight="7"
                  orient="auto-start-reverse"
                >
                  <path d="M0 0 10 5 0 10z" fill="#8b5cf6"></path>
                </marker>
              </defs>
              {
                [
                  ["🎥", "Lezione", "Diretta ARI Toscana"],
                  ["📝", "Trascrizione", "Testo della registrazione"],
                  ["📘", "Guida di studio", "Struttura fissa"],
                  ["✅", "Autoverifica", "Domande e ripasso"],
                  ["📡", "Esame", "Programma ministeriale"],
                ].map(([icon, name, sub], i) => (
                  <g transform={`translate(${i * 201} 40)`}>
                    <rect
                      width="154"
                      height="140"
                      rx="16"
                      fill={i === 2 ? "#eef2ff" : "#ffffff"}
                      stroke={i === 2 ? "#6366f1" : "#c7d2fe"}
                      stroke-width={i === 2 ? 2 : 1.5}
                    />
                    <circle cx="22" cy="22" r="13" fill="#4f46e5" />
                    <text
                      x="22"
                      y="27"
                      text-anchor="middle"
                      font-size="14"
                      font-weight="700"
                      fill="#fff"
                    >
                      {i + 1}
                    </text>
                    <text x="77" y="68" text-anchor="middle" font-size="30">
                      {icon}
                    </text>
                    <text
                      x="77"
                      y="102"
                      text-anchor="middle"
                      font-size="15"
                      font-weight="700"
                      fill="#0b1220"
                    >
                      {name}
                    </text>
                    <text
                      x="77"
                      y="122"
                      text-anchor="middle"
                      font-size="11.5"
                      fill="#475569"
                    >
                      {sub}
                    </text>
                  </g>
                ))
              }
              {
                [0, 1, 2, 3].map((i) => (
                  <line
                    x1={i * 201 + 160}
                    y1="110"
                    x2={i * 201 + 197}
                    y2="110"
                    stroke="#8b5cf6"
                    stroke-width="2.5"
                    marker-end="url(#ah)"
                  />
                ))
              }
            </svg>

            <svg
              class="flow-v"
              viewBox="0 0 320 540"
              role="img"
              aria-labelledby="flow-v-t flow-v-d"
              xmlns="http://www.w3.org/2000/svg"
            >
              <title id="flow-v-t">Percorso di studio</title>
              <desc id="flow-v-d"
                >Lezione in diretta, trascrizione, guida di studio, autoverifica
                ed esame.</desc
              >
              <defs>
                <marker
                  id="av"
                  viewBox="0 0 10 10"
                  refX="8"
                  refY="5"
                  markerWidth="7"
                  markerHeight="7"
                  orient="auto-start-reverse"
                >
                  <path d="M0 0 10 5 0 10z" fill="#8b5cf6"></path>
                </marker>
              </defs>
              {
                [
                  ["🎥", "Lezione", "Diretta ARI Toscana"],
                  ["📝", "Trascrizione", "Testo della registrazione"],
                  ["📘", "Guida di studio", "Struttura fissa"],
                  ["✅", "Autoverifica", "Domande e ripasso"],
                  ["📡", "Esame", "Programma ministeriale"],
                ].map(([icon, name, sub], i) => (
                  <g transform={`translate(10 ${i * 112})`}>
                    <rect
                      width="300"
                      height="76"
                      rx="14"
                      fill={i === 2 ? "#eef2ff" : "#ffffff"}
                      stroke={i === 2 ? "#6366f1" : "#c7d2fe"}
                      stroke-width={i === 2 ? 2 : 1.5}
                    />
                    <text x="38" y="48" text-anchor="middle" font-size="26">
                      {icon}
                    </text>
                    <text
                      x="72"
                      y="34"
                      font-size="15"
                      font-weight="700"
                      fill="#0b1220"
                    >{`${i + 1}. ${name}`}</text>
                    <text x="72" y="56" font-size="12.5" fill="#475569">
                      {sub}
                    </text>
                  </g>
                ))
              }
              {
                [0, 1, 2, 3].map((i) => (
                  <line
                    x1="160"
                    y1={i * 112 + 80}
                    x2="160"
                    y2={i * 112 + 108}
                    stroke="#8b5cf6"
                    stroke-width="2.5"
                    marker-end="url(#av)"
                  />
                ))
              }
            </svg>
          </figure>
        </div>
      </section>

      <!-- Approfondimento -->
      <section id="approfondimento" class="section alt">
        <div class="container split">
          <div class="reveal">
            <p class="eyebrow">Approfondimento</p>
            <h2>Anatomia di una guida</h2>
            <p>
              Le guide seguono lo stesso scheletro di base. Si parte da obiettivi e
              prerequisiti, si procede per argomenti numerati nell’ordine della
              lezione e si chiude con strumenti di ripasso.
            </p>
            <ul class="checks">
              <li>
                Concetti spiegati in prosa, con termini tecnici definiti alla
                prima occorrenza
              </li>
              <li>Formule e regole in blocchi dedicati e riconoscibili</li>
              <li>
                Riferimenti agli argomenti da esame quando citati dal relatore
              </li>
              <li>
                Avvisi quando un passaggio della trascrizione è incompleto
              </li>
            </ul>
          </div>
          <div
            class="codeblock reveal"
            aria-label="Struttura di una guida di studio"
          >
            <div class="code-bar">
              <span class="code-name">lezione_22.md</span>
            </div>
            <pre><code>## 📌 Panoramica
## 📖 Contenuti Teorici
   ### 1. Correzione Quiz sulle Antenne
   ### 2. Parole Chiave della Normativa
   ### 3. Gerarchia Normativa
   ...
## 🔗 Mappa Concettuale
## 📝 Punti Chiave
## ❓ Domande di Comprensione
## 📚 Glossario
## 📅 Informazioni Lezione</code></pre>
          </div>
        </div>
      </section>

      <!-- Governance -->
      <section id="governance" class="section">
        <div class="container">
          <header class="section-head reveal">
            <p class="eyebrow">Governance</p>
            <h2>Qualità e trasparenza dei contenuti</h2>
            <p>Regole semplici per mantenere le guide affidabili nel tempo.</p>
          </header>
          <div class="grid grid-3">
            <article class="card reveal">
              <span class="icon" aria-hidden="true">🎯</span>
              <h3>Fedeltà alla lezione</h3>
              <p>
                Si riporta solo ciò che è stato detto nel corso. Dove la
                trascrizione è incerta, la guida lo segnala.
              </p>
            </article>
            <article class="card reveal">
              <span class="icon" aria-hidden="true">📝</span>
              <h3>Trascrizioni corrette</h3>
              <p>
                Gli errori evidenti di trascrizione automatica vengono corretti,
                senza aggiungere informazioni assenti nella lezione.
              </p>
            </article>
            <article class="card reveal">
              <span class="icon" aria-hidden="true">📜</span>
              <h3>Testi ufficiali</h3>
              <p>
                Sono appunti del corso, non il testo ufficiale. Per l’esame
                fanno fede i documenti citati nella sezione sugli esami.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Percorsi -->
      <section id="percorsi" class="section alt">
        <div class="container">
          <header class="section-head reveal">
            <p class="eyebrow">Percorsi</p>
            <h2>Tre tappe, dal primo circuito alla normativa</h2>
            <p>
              Segui l’ordine del corso o salta direttamente alla parte che ti
              serve.
            </p>
          </header>
          <div class="grid grid-3">
            {
              tracks.map((t) => (
                <article
                  class:list={[
                    "card",
                    "plan",
                    "reveal",
                    { featured: t.featured },
                  ]}
                >
                  {t.featured && (
                    <span class="tag">Consigliato per il ripasso</span>
                  )}
                  <span class="icon" aria-hidden="true">
                    {t.icon}
                  </span>
                  <h3>{t.name}</h3>
                  <p class="range">{t.range}</p>
                  <p>{t.text}</p>
                  <a class="link" href={lesson(t.start)}>
                    Parti da Lezione {t.start} →
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Esami -->
      <section id="esami" class="section">
        <div class="container">
          <header class="section-head reveal">
            <p class="eyebrow">Gli esami</p>
            <h2>Esame completo o esame ridotto?</h2>
            <p>
              Il programma ufficiale ha tre parti: A (tecnica), B (procedure
              d’esercizio) e C (regolamentazione). Con un titolo di esonero
              salti la sola Parte A.
            </p>
          </header>

          <div class="grid grid-2">
            <article class="card exam-card reveal">
              <h3>Esame completo</h3>
              <p class="range">Parti A, B e C</p>
              <ul>
                <li>50 domande a risposta multipla, con 3 opzioni ciascuna</li>
                <li>
                  30 domande tecniche (Parte A) e 20 su procedure e normativa
                  (Parti B e C)
                </li>
                <li>Durata: 2 ore</li>
                <li>
                  Superato con 30 risposte corrette, di cui almeno 18 tecniche e
                  12 su procedure e normativa
                </li>
              </ul>
            </article>
            <article class="card exam-card reveal">
              <h3>Esame ridotto</h3>
              <p class="range">Solo Parti B e C</p>
              <ul>
                <li>Esonero parziale dalla sola Parte A</li>
                <li>20 domande sulle Parti B e C</li>
                <li>Superato con 12 risposte corrette</li>
              </ul>
            </article>
          </div>

          <p class="exam-note reveal">
            <strong
              >L’esonero riguarda solo la Parte A: nessun titolo esonera dalle
              Parti B e C.</strong
            > I numeri sono quelli del decreto direttoriale del 6 marzo 2024, applicato
            anche al 2026.
          </p>
          <p class="exam-year reveal">
            <strong>Toscana 2026:</strong> sessione unica per esame completo ed
            esonero parziale. Domande entro il 10 ottobre 2026; esame entro le
            prime due settimane di novembre 2026 a Firenze. Leggi la{" "}
            <a
              href={sources[2].href}
              rel="noopener"
              >determina dell’Ispettorato Toscana per il 2026</a
            >.
          </p>

          <h3 class="exam-sub reveal">Chi può fare l’esame ridotto</h3>
          <div class="reveal">
            <p>
              Hanno diritto all’esonero parziale i titolari di alcuni titoli
              di studio e abilitazioni. Alcuni esempi:
            </p>
            <ul class="checks">
              <li>
                Laurea di primo livello in Ingegneria dell’informazione (classe
                L-8)
              </li>
              <li>
                Diploma di istituto tecnico nei settori tecnologici Elettronica
                ed elettrotecnica, oppure Informatica e telecomunicazioni
              </li>
              <li>
                Certificato GMDSS GOC o LRC del Ministero, in corso di validità
              </li>
            </ul>
          </div>
          <div class="faq exam-titles reveal">
            <details>
              <summary>Elenco completo dei titoli (art. 5 del DM 2021)</summary>
              <p class="exam-group">Abilitazioni</p>
              <ul>
                <li>
                  Certificato GMDSS GOC o LRC del Ministero in corso di validità
                </li>
                <li>
                  Analoghi certificati esteri riconosciuti (D.Lgs. 71/2015,
                  artt. 19-20)
                </li>
                <li>
                  Certificato di radiotelegrafista per navi di classe prima,
                  seconda e speciale
                </li>
                <li>Diploma di radiotelegrafista di bordo</li>
              </ul>
              <p class="exam-group">Titoli di studio</p>
              <ul>
                <li>
                  Laurea di primo livello (DM 270/2004) nelle classi L-8
                  Ingegneria dell’informazione, L-9 Ingegneria industriale,
                  L-28 Scienze e tecnologie della navigazione, L-30 Scienze e
                  tecnologie fisiche, L-31 Scienze e tecnologie informatiche,
                  L-35 Scienze matematiche
                </li>
                <li>
                  Lauree di primo livello (DM 509/1999) nelle classi 9, 10, 22,
                  25, 26, 32
                </li>
                <li>
                  Lauree magistrali (DM 270/2004) nelle classi LM-17, 18, 25,
                  26, 27, 28, 29, 32, 33, 34, 40, 44, 66, 72, 91
                </li>
                <li>
                  Diplomi di laurea e lauree specialistiche equiparati (DI 9
                  luglio 2009)
                </li>
                <li>
                  Diploma di istituto tecnico nei settori tecnologici
                  Elettronica ed elettrotecnica, oppure Informatica e
                  telecomunicazioni
                </li>
              </ul>
              <p>
                I titoli di università non statali riconosciute o di Paesi UE
                valgono se dichiarati equivalenti (art. 5, comma 3).
              </p>
            </details>
          </div>
          <p class="exam-note reveal">
            Verifica il tuo titolo sul testo dell’art. 5 del{" "}
            <a href={sources[0].href} rel="noopener">DM 1 marzo 2021</a> e con
            l’Ispettorato. Il titolo si allega alla domanda online (a lezione si consiglia il PDF).
          </p>

          <h3 class="exam-sub reveal">Quali lezioni servono per l’esame ridotto</h3>
          <div class="grid grid-3">
            {
              examLessons.map((l) => (
                <article class="card plan exam-card reveal">
                  <span class="tag">Esame ridotto</span>
                  <h3>
                    Lezione {String(l.n).padStart(2, "0")} · {l.title}
                  </h3>
                  <p class="range">Punti del programma: {l.points}</p>
                  <p>Sezioni utili:</p>
                  <ul>
                    {l.sections.map(([name, point]) => (
                      <li>
                        {name}
                        {point && (
                          <>
                            {" "}
                            <code>{point}</code>
                          </>
                        )}
                      </li>
                    ))}
                  </ul>
                  <p class="exam-card-note">{l.note}</p>
                  <a class="link" href={lesson(l.n)}>
                    Apri la Lezione {String(l.n).padStart(2, "0")} →
                  </a>
                </article>
              ))
            }
          </div>
          <p class="exam-note reveal">
            Le altre 19 lezioni sono la Parte A del programma: servono solo per
            l’esame completo.
          </p>

          <aside class="notice reveal" aria-labelledby="esami-mancanti">
            <h3 id="esami-mancanti">Cosa non è negli appunti</h3>
            <p>
              Alcuni punti ufficiali delle Parti B e C non sono trattati negli
              appunti. Studiali sul Sub allegato D del{" "}
              <a href={sources[0].href} rel="noopener">DM 1 marzo 2021</a>:
            </p>
            <ul>
              <li>
                Segnali internazionali di soccorso e comunicazioni in caso di
                catastrofi: SOS, MAYDAY, Risoluzione n. 640 UIT (B.4)
              </li>
              <li>Tenuta del registro di stazione (C.3)</li>
              <li>Regioni radio UIT (C.1)</li>
              <li>
                Elenchi completi dei 15 codici Q (B.2) e delle 13 abbreviazioni
                operative (B.3): gli appunti della lezione 08 ne riportano solo
                una parte
              </li>
            </ul>
          </aside>

          <h3 class="exam-sub reveal">Fonti ufficiali</h3>
          <ul class="sources reveal">
            {
              sources.map((s) => (
                <li>
                  <a href={s.href} rel="noopener">
                    {s.name}
                  </a>
                  <span>{s.detail}</span>
                </li>
              ))
            }
          </ul>
          <p class="exam-note reveal">
            I contenuti di questo sito sono appunti estratti dalle lezioni del
            corso per radioamatori della Toscana (edizioni 2025 e 2026). Per
            l’esame fanno fede i testi ufficiali.
          </p>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="section alt">
        <div class="container narrow">
          <header class="section-head reveal">
            <p class="eyebrow">FAQ</p>
            <h2>Domande frequenti</h2>
          </header>
          <div class="faq reveal">
            {
              faqs.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>
                    {f.a}
                    {f.href && (
                      <>
                        {" "}
                        <a href={f.href}>{f.link}</a>
                      </>
                    )}
                  </p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta">
        <div class="container reveal">
          <h2>Pronto a iniziare?</h2>
          <p>
            Parti dalla prima lezione: bastano pochi minuti per capire come sono
            fatte le guide.
          </p>
          <a class="btn btn-light" href={lesson(1)}>Apri la Lezione 1</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container foot">
        <p>
          Corso Aspiranti Radioamatori ARI Toscana CRT · Appunti estratti dalle
          lezioni (edizioni 2025 e 2026) · Materiale di studio non ufficiale
        </p>
        <nav aria-label="Link utili">
          <a href={`${base}/lezioni/`}>Lezioni</a>
          <a href="#esami">Gli esami</a>
          <a href="#main">Torna su</a>
        </nav>
      </div>
      <p class="build-info" title="Versione del sito e ultimo publish">
        v{buildNumber} · {buildDate}
      </p>
    </footer>

    <script is:inline>
      (function () {
        var els = document.querySelectorAll(".reveal");
        var reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach(function (el) {
            el.classList.add("in");
          });
        } else {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add("in");
                  io.unobserve(e.target);
                }
              });
            },
            { threshold: 0.12 },
          );
          els.forEach(function (el) {
            io.observe(el);
          });
        }
      })();
    </script>
  </body>
</html>
