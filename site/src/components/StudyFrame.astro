---
import Default from '@astrojs/starlight/components/PageFrame.astro';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import '../styles/study.css';

const route = Astro.locals.starlightRoute;
type SidebarEntry = StarlightRouteData['sidebar'][number];
type SidebarLink = Extract<SidebarEntry, { type: 'link' }>;
function links(entries: SidebarEntry[]): SidebarLink[] {
  return entries.flatMap((entry) => entry.type === 'link' ? [entry] : links(entry.entries));
}
const lessons = links(route.sidebar);
const sequence = lessons.filter((lesson) => /lezione_\d+\/?$/.test(lesson.href));
const currentLessonIndex = sequence.findIndex((lesson) => lesson.isCurrent);
const previousLesson = currentLessonIndex > 0 ? sequence[currentLessonIndex - 1] : undefined;
const nextLesson = currentLessonIndex >= 0 && currentLessonIndex < sequence.length - 1 ? sequence[currentLessonIndex + 1] : undefined;
const headings = route.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<Default>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</Default>

<div id="study-toolbar-spacer" aria-hidden="true" hidden></div>

<div class="study-toolbar" aria-label="Strumenti di studio" data-pagefind-ignore hidden>
  <button
    type="button"
    id="study-menu-toggle"
    aria-expanded="false"
    aria-controls="study-menu"
    aria-haspopup="dialog"
    aria-label="Apri indice e lezioni"
  >
    Indice
  </button>
  <button type="button" id="study-reading-toggle" aria-pressed="false" aria-label="Attiva lettura">
    Attiva lettura
  </button>
  <details class="study-text-settings">
    <summary aria-label="Apri le impostazioni del testo">Testo</summary>
    <fieldset class="study-text-settings__panel">
      <legend>Personalizza la lettura</legend>
      <label for="study-page-font-size">Dimensione del testo</label>
      <select id="study-page-font-size" data-study-font-size>
        <option value="14">14 px</option>
        <option value="16">16 px</option>
        <option value="18">18 px</option>
        <option value="20" selected>20 px</option>
        <option value="22">22 px</option>
      </select>
      <label for="study-page-line-height">Interlinea</label>
      <select id="study-page-line-height" data-study-line-height>
        <option value="1">1,0</option>
        <option value="1.2">1,2</option>
        <option value="1.4">1,4</option>
        <option value="1.6">1,6</option>
        <option value="1.8" selected>1,8</option>
      </select>
    </fieldset>
  </details>
</div>

<div class="study-menu-backdrop" id="study-backdrop" hidden></div>
<section class="study-menu" id="study-menu" role="dialog" aria-modal="true" aria-labelledby="study-menu-title" tabindex="-1" data-pagefind-ignore hidden>
  <div class="study-menu__header">
    <h2 id="study-menu-title">Il tuo libro di studio</h2>
    <button type="button" id="study-menu-close">Chiudi</button>
  </div>
  <p class="study-menu__chapter">{route.entry.data.title}</p>
  <fieldset class="study-menu__settings">
    <legend>Lettura</legend>
    <p>Usa <strong>Attiva lettura</strong> per studiare la lezione come una pagina di libro, con il testo più ampio e senza pannelli laterali.</p>
    <label for="study-font-size">Dimensione del testo</label>
    <select id="study-font-size" data-study-font-size>
      <option value="14">14 px</option>
      <option value="16">16 px</option>
      <option value="18">18 px</option>
      <option value="20" selected>20 px</option>
      <option value="22">22 px</option>
    </select>
    <label for="study-line-height">Interlinea</label>
    <select id="study-line-height" data-study-line-height>
      <option value="1">1,0</option>
      <option value="1.2">1,2</option>
      <option value="1.4">1,4</option>
      <option value="1.6">1,6</option>
      <option value="1.8" selected>1,8</option>
    </select>
    <p>Dimensione e interlinea si applicano in modalità lettura, anche dal comando Testo sulla pagina. Il tema chiaro o scuro rimane quello scelto nel sito.</p>
    <button type="button" id="study-fullscreen">Schermo intero</button>
    <p id="study-fullscreen-help">Su iPad: in Safari apri Condividi → Aggiungi alla schermata Home, poi apri la lezione dall’icona. Le barre del browser non saranno visibili.</p>
    <p>Il Reader di Safari, quando disponibile nel menu della pagina, è una funzione separata: la modalità lettura del sito mantiene immagini, formule e navigazione.</p>
    <p id="study-status" role="status" aria-live="polite"></p>
  </fieldset>
  {(previousLesson || nextLesson) && (
    <nav aria-label="Passa tra le lezioni" class="study-menu__contents">
      <h3>Vai alla lezione</h3>
      <ul>
        {previousLesson && (
          <li><a href={previousLesson.href}>← {previousLesson.label}</a></li>
        )}
        {nextLesson && (
          <li><a href={nextLesson.href}>{nextLesson.label} →</a></li>
        )}
      </ul>
    </nav>
  )}
  {headings.length > 0 && (
    <nav aria-label="Indice della lezione" class="study-menu__contents">
      <h3>In questa pagina</h3>
      <ul>
        {headings.map((heading) => (
          <li class:list={{ 'study-menu__subheading': heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  <nav aria-label="Lezioni del corso" class="study-menu__contents">
    <h3>Lezioni del corso</h3>
    <ul>
      {lessons.map((lesson) => (
        <li>
          <a
            href={lesson.href}
            aria-current={lesson.isCurrent ? 'page' : undefined}
            aria-label={[lesson.label, lesson.badge?.text, lesson.isCurrent ? 'lezione aperta' : undefined].filter(Boolean).join(', ')}
            data-study-current-lesson={lesson.isCurrent ? '' : undefined}
          >
            {lesson.label}
            {lesson.badge && <span class="study-menu__badge">{lesson.badge.text}</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>

<script>
  import '../scripts/study-reader';
</script>
